# Settings of every tape (Source demo/tapes/settings.tape)
Set Shell bash
Set FontSize 13
Set Columns 160
Set Rows 40
Set Padding 10
Set TypingSpeed 70ms
Set CursorBlink false
Set Framerate 25
# Neovim's default colours
Set Theme { "name": "Neovim", "background": "#14161b", "foreground": "#e0e2ea", "selection": "#4f5258", "cursor": "#e0e2ea", "black": "#07080d", "red": "#ffc0b9", "green": "#b3f6c0", "yellow": "#fce094", "blue": "#a6dbff", "magenta": "#ffcaff", "cyan": "#8cf8f7", "white": "#c4c6cd", "brightBlack": "#4f5258", "brightRed": "#ffc0b9", "brightGreen": "#b3f6c0", "brightYellow": "#fce094", "brightBlue": "#a6dbff", "brightMagenta": "#ffcaff", "brightCyan": "#8cf8f7", "brightWhite": "#eef1f8" }
